<Mod id="c086b5a6-90d2-4dea-a32f-c642639b9469" version="2.1">
  <Properties>
    <Name>LOC_CORPORATIONS_DIVERSITY_NAME</Name>
    <Description>Brand New Industries and Corporations Game Mode</Description>
    <Teaser>Corporations Diversity</Teaser>
    <Authors>DeepLogic, 六亿神州尽舜尧, 小灰灰, 笑笑</Authors>
    <SpecialThanks>Leugi</SpecialThanks>
    <AffectsSavedGames>1</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
