  <LocalizedText>
    <Text id="LOC_CORPORATIONS_DIVERSITY_NAME">
      <en_US>[COLOR_Civ6LightBlue]Harmony in Diversity v2.1: Industries and Corporations[ENDCOLOR]</en_US>
      <zh_Hans_CN>[COLOR_Civ6LightBlue]【和而不同 v2.1】行业与公司[ENDCOLOR]</zh_Hans_CN>
    </Text>
  </LocalizedText>
